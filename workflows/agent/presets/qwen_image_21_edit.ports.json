  "defaults": {
    "denoise": 1.0,
    "steps": 25,
    "cfg": 1.0,
    "resolution": 1024,
    "filename_prefix": "Qwen_Image_2.1",
    "gguf_name": "Qwen-Image-2.1-Q4.gguf",
    "clip_name": "qwen3vl_8b_w4a8.safetensors",
    "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
  },
  "notes": [
    "Uses UnetLoaderGGUF for low VRAM consumption (5.5GB Q4)",
    "Uses TextEncodeQwenImage21 for direct 2K resolution and multi-image condition",
    "Uses QwenImage21Cache to accelerate sampling speed",
    "Agent API graph has LoadImage node 470 only. -i2/-i3 inject LoadImage at runtime onto node 484 inputs images.image_2 / images.image_3. Human UI node 475 is not in this API graph.",
    "No Lightning / enable_turbo port. steps 25, cfg 1.0."
  ]
}