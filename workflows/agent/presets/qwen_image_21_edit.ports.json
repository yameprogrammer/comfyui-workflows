    },
    "resolution": {
      "node": "484",
      "key": "resolution",
      "optional": true
    },
    "seed": {
      "node": "481",
      "key": "seed"
    },
    "steps": {
      "node": "481",
      "key": "steps",
      "optional": true
    },
    "cfg": {
      "node": "481",
      "key": "cfg",
      "optional": true
    },
    "denoise": {
      "node": "481",
      "key": "denoise",
      "optional": true
    },
    "gguf_name": {
      "node": "485",
      "key": "unet_name",
      "optional": true
    },
    "clip_name": {
      "node": "477",
      "key": "clip_name",
      "optional": true
    },
    "vae_name": {
      "node": "478",
      "key": "vae_name",
      "optional": true
    },
    "filename_prefix": {
      "node": "461",
      "key": "filename_prefix",
      "optional": true
    }
